generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  WHATSAPP_CLOUD
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  AUDIO
  STICKER
  DOCUMENT
  LOCATION
  SYSTEM
}

enum MessageRole {
  USER
  TOM
  SYSTEM
}

enum ConversationType {
  PRIVATE_TOM
  GROUP
}

enum GroupStatus {
  ACTIVE
  DISABLED
}

enum StoredReactionType {
  TEXT
  VOICE
  AUDIO
  STICKER
  IMAGE
  MEME
}

enum ReactionTagName {
  FUNNY
  HAPPY
  CONFUSED
  SHOCK
  TEASING
  ROAST
  REACTION
  CALM
  SERIOUS
  CELEBRATION
}

enum ReactionScope {
  PERSONAL_LIBRARY
  GROUP_ONLY
  GLOBAL_APPROVED
  DISABLED
}

enum ScheduleStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum ReminderStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum AIInteractionStatus {
  STARTED
  COMPLETED
  FAILED
}

enum AIToolStatus {
  STARTED
  COMPLETED
  FAILED
}

enum BotEventType {
  MESSAGE_RECEIVED
  MESSAGE_SENT
  MESSAGE_SEND_FAILED
  WHATSAPP_CONNECTED
  WHATSAPP_CONFIGURATION_ERROR
  TOM_INVOKED
  AI_STARTED
  AI_COMPLETED
  AI_FAILED
  TOOL_STARTED
  TOOL_COMPLETED
  TOOL_FAILED
  REMINDER_CREATED
  REMINDER_SENT
  REMINDER_FAILED
  SCHEDULE_CREATED
  REACTION_STORED
  REACTION_USED
  WEBHOOK_RECEIVED
  WEBHOOK_REJECTED
  WEBHOOK_FAILED
  GROUP_DISCOVERED
  GROUP_UPDATED
  WORKER_HEARTBEAT
  GROUP_CONTEXT_REQUESTED
  CROSS_CONVERSATION_ACCESS_BLOCKED
  DESTINATION_MISMATCH_BLOCKED
  SYSTEM_ERROR
}

enum LogLevel {
  DEBUG
  INFO
  WARNING
  ERROR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auditLogs    AuditLog[]
}

model User {
  id                String                   @id @default(cuid())
  displayName       String?
  externalId        String                   @unique
  locale            String?
  timezone          String                   @default("Europe/London")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  preferences       UserPreference?
  messages          Message[]
  mediaAssets       MediaAsset[]
  storedReactions   StoredReaction[]
  memories          TomMemory[]
  schedules         Schedule[]
  reminders         Reminder[]
  groupMemberships  GroupMember[]
  reactionFeedback  UserReactionPreference[]
}

model UserPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  languageMode     String   @default("TANGLISH")
  voiceMode        String   @default("WHEN_REQUESTED")
  humourMode       String   @default("LIGHT")
  contextWindow    Int      @default(30)
  friendlyRoast    Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsAppAccount {
  id                    String   @id @default(cuid())
  businessAccountId     String?
  phoneNumberId         String   @unique
  displayPhoneNumber    String?
  provider              Provider @default(WHATSAPP_CLOUD)
  webhookVerifiedAt     DateTime?
  lastWebhookAt         DateTime?
  lastIncomingMessageAt DateTime?
  lastOutgoingMessageAt DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Conversation {
  id          String    @id @default(cuid())
  provider    Provider  @default(WHATSAPP_CLOUD)
  type        ConversationType @default(GROUP)
  externalId  String
  title       String?
  groupId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  messages    Message[]
  schedules   Schedule[]
  reminders   Reminder[]

  @@unique([provider, externalId])
  @@index([groupId])
}

model Group {
  id            String        @id @default(cuid())
  provider      Provider      @default(WHATSAPP_CLOUD)
  externalId    String        @unique
  name          String?
  status        GroupStatus   @default(ACTIVE)
  tomEnabled    Boolean       @default(false)
  tomAuthorized Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  members       GroupMember[]
  conversations Conversation[]
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("MEMBER")
  canView   Boolean  @default(true)
  canManage Boolean  @default(false)
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, leftAt])
}

model Message {
  id                         String          @id @default(cuid())
  provider                   Provider        @default(WHATSAPP_CLOUD)
  providerMessageId          String
  conversationId             String
  senderUserId               String?
  role                       MessageRole
  type                       MessageType
  text                       String?
  providerMediaId            String?
  replyToProviderMessageId   String?
  timestamp                  DateTime
  tomInvoked                 Boolean         @default(false)
  storeInvoked               Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  conversation               Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser                 User?           @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  mediaAssets                MediaAsset[]
  sourceSchedules            Schedule[]      @relation("ScheduleSourceMessage")
  sourceReminders            Reminder[]      @relation("ReminderSourceMessage")
  aiInteractions             AIInteraction[]

  @@unique([provider, providerMessageId])
  @@index([conversationId, timestamp])
  @@index([senderUserId])
}

model MediaAsset {
  id                String    @id @default(cuid())
  provider          Provider  @default(WHATSAPP_CLOUD)
  providerMediaId   String?
  ownerUserId       String?
  messageId         String?
  storageKey        String
  mimeType          String
  byteSize          Int
  sha256            String?
  transcript        String?
  createdAt         DateTime  @default(now())
  owner             User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  message           Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  storedReactions   StoredReaction[]

  @@unique([storageKey])
  @@index([providerMediaId])
  @@index([ownerUserId])
}

model StoredReaction {
  id            String                   @id @default(cuid())
  ownerUserId   String
  mediaAssetId  String?
  type          StoredReactionType
  originalText  String?
  transcript    String?
  mood          String?
  intensity     Int                      @default(1)
  scope         ReactionScope            @default(PERSONAL_LIBRARY)
  allowedGroupId String?
  sourceMessageId String?
  sourceConversationId String?
  usageCount    Int                      @default(0)
  likes         Int                      @default(0)
  dislikes      Int                      @default(0)
  enabled       Boolean                  @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  owner         User                     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset?              @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  tags          ReactionTag[]
  preferences   UserReactionPreference[]

  @@index([ownerUserId, type, enabled])
  @@index([allowedGroupId, enabled])
}

model ReactionTag {
  id               String          @id @default(cuid())
  storedReactionId String
  name             ReactionTagName
  storedReaction   StoredReaction  @relation(fields: [storedReactionId], references: [id], onDelete: Cascade)

  @@unique([storedReactionId, name])
}

model UserReactionPreference {
  id               String         @id @default(cuid())
  userId           String
  storedReactionId String
  score            Int            @default(0)
  lastFeedbackAt   DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedReaction   StoredReaction @relation(fields: [storedReactionId], references: [id], onDelete: Cascade)

  @@unique([userId, storedReactionId])
}

model TomMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  scope     String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, scope])
}

model Schedule {
  id              String          @id @default(cuid())
  userId          String
  conversationId  String?
  sourceMessageId String?
  title           String
  description     String?
  timezone        String          @default("Europe/London")
  status          ScheduleStatus  @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage   Message?        @relation("ScheduleSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  items           ScheduleItem[]

  @@index([userId, status])
  @@index([conversationId])
}

model ScheduleItem {
  id          String    @id @default(cuid())
  scheduleId  String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  schedule    Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startsAt])
}

model Reminder {
  id              String         @id @default(cuid())
  userId          String
  conversationId  String?
  sourceMessageId String?
  title           String
  description     String?
  remindAt        DateTime
  timezone        String         @default("Europe/London")
  status          ReminderStatus @default(SCHEDULED)
  bullJobId       String?
  deliveryKey     String?        @unique
  attempts        Int            @default(0)
  lastError        String?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  sourceMessage   Message?       @relation("ReminderSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, status, remindAt])
  @@index([bullJobId])
}

model AIInteraction {
  id              String              @id @default(cuid())
  messageId       String?
  userId          String?
  model           String
  status          AIInteractionStatus @default(STARTED)
  inputTokens     Int                 @default(0)
  outputTokens    Int                 @default(0)
  estimatedCost   Decimal?            @db.Decimal(12, 6)
  latencyMs       Int?
  error           String?
  metadata        Json?
  createdAt       DateTime            @default(now())
  completedAt     DateTime?
  message         Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  toolInvocations AIToolInvocation[]

  @@index([messageId])
  @@index([createdAt])
}

model AIToolInvocation {
  id              String          @id @default(cuid())
  aiInteractionId String
  toolName        String
  status          AIToolStatus    @default(STARTED)
  arguments       Json
  result          Json?
  error           String?
  createdAt       DateTime        @default(now())
  completedAt     DateTime?
  aiInteraction   AIInteraction   @relation(fields: [aiInteractionId], references: [id], onDelete: Cascade)

  @@index([aiInteractionId, toolName])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  provider        Provider @default(WHATSAPP_CLOUD)
  providerEventId String
  signatureValid  Boolean  @default(false)
  processedAt     DateTime?
  payload         Json
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([createdAt])
}

model BotEvent {
  id        String       @id @default(cuid())
  type      BotEventType
  level     LogLevel     @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([type, createdAt])
  @@index([level, createdAt])
}

model BotError {
  id            String   @id @default(cuid())
  code          String
  message       String
  stack         String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([code, createdAt])
  @@index([correlationId])
}

model WorkerHeartbeat {
  id          String   @id @default(cuid())
  workerName  String   @unique
  lastSeenAt  DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  adminUser   AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

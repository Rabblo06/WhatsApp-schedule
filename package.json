{
  "name": "tom",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "format": "prettier --write .",
    "prisma:validate": "corepack pnpm --filter @tom/database prisma:validate",
    "db:migrate": "corepack pnpm --filter @tom/database prisma:migrate",
    "db:generate": "corepack pnpm --filter @tom/database prisma:generate",
    "worker": "corepack pnpm --filter @tom/worker dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

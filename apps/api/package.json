{
  "name": "@tom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "corepack pnpm --workspace-root db:generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@tom/database": "workspace:*",
    "@tom/shared": "workspace:*",
    "@tom/types": "workspace:*",
    "cookie": "^1.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie": "^0.6.0",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
